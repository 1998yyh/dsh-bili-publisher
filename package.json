{
  "name": "dsh-bili-publisher",
  "version": "0.1.0-dev.0",
  "private": true,
  "description": "独立的 DSH B 站发布插件：文字与图文动态、视频投稿和稿件状态查询（开发中）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "tools",
    "cordis.patch.yml",
    "README.md",
    "docs",
    "examples",
    "ROADMAP.md"
  ],
  "scripts": {
    "check": "node tools/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "publisher": "node tools/publisher.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1998yyh/dsh-bili-publisher.git"
  },
  "bugs": {
    "url": "https://github.com/1998yyh/dsh-bili-publisher/issues"
  },
  "homepage": "https://github.com/1998yyh/dsh-bili-publisher#readme",
  "license": "UNLICENSED",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "bilibili",
    "publisher"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "sharp": "^0.35.5"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2"
  },
  "bin": {
    "dsh-bili-publisher": "./tools/publisher.mjs"
  },
  "overrides": {
    "zod": "4.6.6"
  }
}
